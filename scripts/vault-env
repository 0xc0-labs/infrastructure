# Sourced by the other scripts, never run on its own. vault_env reads a secret
# only when its variable is unset: in CI the workflows set them all
# (docs/architecture.md, Secrets). Values go into the environment only, never
# onto disk or the screen.

export VAULT_ADDR="${VAULT_ADDR:-https://vault.int.0xc0.cc}"

vault_env() { # variable path key [mount, ci by default]
  local var="$1" path="$2" key="$3" mount="${4:-ci}" value
  [ -z "${!var:-}" ] || return 0
  if [ -z "${vault_env_checked:-}" ]; then
    vault token lookup >/dev/null 2>&1 || { echo "not logged in to Vault: vault login -no-print" >&2; exit 1; }
    vault_env_checked=1
  fi
  value="$(vault kv get -mount="$mount" -field="$key" "$path")"
  export "$var=$value"
}

vault_env_state() {
  vault_env AWS_ACCESS_KEY_ID shared/rustfs access_key_id
  vault_env AWS_SECRET_ACCESS_KEY shared/rustfs secret_access_key
}

vault_env_proxmox() {
  vault_env PROXMOX_VE_ENDPOINT infrastructure/proxmox endpoint
  vault_env PROXMOX_VE_API_TOKEN infrastructure/proxmox api_token
}
