#!/usr/bin/env bash
# Runs ansible-playbook with its secrets in the environment, never on disk.
# Usage: scripts/ansible playbooks/vm-access.yml --check --diff
set -euo pipefail
cd "$(dirname "$0")/.."

. scripts/python-env
python_env
. scripts/vault-env
vault_env_state
vault_env GITHUB_RUNNER_APPROLE_SECRET_ID infrastructure/runner-approle secret_id
vault_env RKE2_TOKEN infrastructure/rke2 token
# ArgoCD's, under platform/: it is ArgoCD's secret, granted to this CI by name.
vault_env ARGOCD_ADMIN_PASSWORD_BCRYPT argocd/admin password_bcrypt platform

ADMIN_TUNNEL_TOKEN="$(tofu -chdir=environments/prod output -raw admin_tunnel_token)"
export ADMIN_TUNNEL_TOKEN

PUBLIC_TUNNEL_TOKEN="$(tofu -chdir=environments/prod output -raw public_tunnel_token)"
export PUBLIC_TUNNEL_TOKEN

# vm_admin_ssh_keys is the one list, for cloud-init and the base role alike.
ADMIN_SSH_KEYS="$(tofu -chdir=environments/prod output -json vm_admin_ssh_keys)"
export ADMIN_SSH_KEYS

# A dry run changes nothing: every host at once, not one at a time (serial).
case " $* " in
  *" --check "*) set -- -e play_serial=100% "$@" ;;
esac

cd ansible
exec ansible-playbook "$@"
