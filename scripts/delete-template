#!/usr/bin/env bash
# Deletes nothing any more. The packer workflow (0xc0-labs/.github) still
# calls it before every build, which used to delete the template first, so a
# build that failed or was cut left none (#207). Now the build itself,
# scripts/packer <name> build, builds the next template beside the old one and
# swaps it in only once it succeeds (scripts/proxmox-template). Kept until that
# workflow stops calling it.
# Usage: scripts/delete-template <name>
set -euo pipefail
name="${1:?usage: scripts/delete-template <name>}"
echo "$name: not deleted; the build replaces it once its next one is built"
