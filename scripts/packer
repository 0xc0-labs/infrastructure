#!/usr/bin/env bash
# Runs packer against one template with the Proxmox credentials read from Vault
# into the environment only, never onto disk. They are the ones OpenTofu uses.
# Usage: scripts/packer <template> <packer command>   e.g. scripts/packer debian-13-runner build
# A build replaces the template only once it succeeds (scripts/proxmox-template).
set -euo pipefail
cd "$(dirname "$0")/.."

template="${1:?usage: scripts/packer <template> <packer command...>}"
shift
[ -d "packer/$template" ] || { echo "no such template: packer/$template" >&2; exit 1; }

# The Ansible provisioner runs ansible-playbook from PATH: the locked one.
. scripts/python-env
python_env
. scripts/vault-env
vault_env_proxmox

# PROXMOX_VE_API_TOKEN is user@realm!token=secret; Packer takes the two halves.
export PKR_VAR_proxmox_url="${PROXMOX_VE_ENDPOINT%/}/api2/json"
export PKR_VAR_proxmox_username="${PROXMOX_VE_API_TOKEN%%=*}"
export PKR_VAR_proxmox_token="${PROXMOX_VE_API_TOKEN#*=}"

[ "${1:-}" = build ] || exec packer "$@" "packer/$template"

# A build never deletes the template first (#207): it builds the next one
# beside it, and swaps it in only once Packer has finished it.
. scripts/proxmox-template
template_ids "$template"
template_clear_next
shift
packer build "$@" -var "vm_id=$next_id" -var "vm_name=$next_name" "packer/$template"
template_promote
