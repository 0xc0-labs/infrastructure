#!/usr/bin/env bash
# {{ ansible_managed }}
# Starts runner instance $1's listener, as the instance's user, from its state
# directory. What run.sh would add, restarting it and reading its exit code,
# is systemd's here (github-runner@.service).
#
# The just-in-time config goes in through the environment, never the command
# line: the runner removes it before it starts a job (README.md, One instance).
set -euo pipefail
cd "/var/lib/github-runner/$1"
ACTIONS_RUNNER_INPUT_JITCONFIG=$(<"$CREDENTIALS_DIRECTORY/jit")
export ACTIONS_RUNNER_INPUT_JITCONFIG
exec ./bin/Runner.Listener run
