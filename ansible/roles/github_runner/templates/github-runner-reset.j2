#!/usr/bin/env bash
# {{ ansible_managed }}
# Leaves runner instance $1 with nothing from an earlier job: a fresh state
# directory, an empty home and no config of the last runner's. Runs as root
# before every start and after every stop, so what a job wrote outlives it no
# longer than its runner's exit.
#
# The state directory is the runner's root: what it writes, and the job's work
# folder. bin/ and externals/ inside it are root's, where the unit mounts the
# install, read only.
set -euo pipefail
instance="$1"
user="runner-$instance"
state="/var/lib/github-runner/$instance"
rm -rf -- "$state" "/home/$user" "/run/github-runner/$instance/jit"
install -d -o "$user" -g "$user" -m 0700 "$state" "/home/$user"
install -d -o root -g root -m 0755 "$state/bin" "$state/externals"
