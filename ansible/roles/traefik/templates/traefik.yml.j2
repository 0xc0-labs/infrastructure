# {{ ansible_managed }}
global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: INFO

entryPoints:
  websecure:
    address: ":443"

providers:
  file:
    directory: {{ traefik_config_dir }}/dynamic
    watch: true

certificatesResolvers:
  letsencrypt:
    acme:
      storage: {{ traefik_state_dir }}/acme.json
      dnsChallenge:
        provider: cloudflare
        resolvers:
{% for resolver in traefik_acme_resolvers %}
          - "{{ resolver }}"
{% endfor %}
